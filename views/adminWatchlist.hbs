<h2>{{viewedUser.name}}'s Watchlist</h2>
<div class="savedShows">
  {{#if shows.length}}
    {{#each shows}}
      <div class="savedShowCard">
        <h4>{{this.showName}}</h4>
        {{#if this.imageURL}}
          <img src="{{this.imageURL}}" alt="{{this.showName}}">
        {{/if}}
        <p><strong>Genre: </strong>{{this.genre}}</p>
      </div>
    {{/each}}
  {{else}}
    <p>No shows saved yet.</p>
  {{/if}}
</div>
