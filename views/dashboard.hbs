<body>
  <div class="top-right-buttons">
    {{#if (eq user.role "admin")}}<a href="/admin" class="adminButton">Admin Panel</a>{{/if}}
    <a href="/logout" class="logoutButton">Logout</a>
  </div>
</body>

<h2>Welcome to Watchly, {{user.username}}!</h2>

<form id="searchForm">
  <input type="text" id="searchInput" placeholder="Search TV Shows">
  <button type="submit">Search</button>
</form>

<div id="results"></div>

<h3>Your Watchlist:</h3>
<div class="saved-shows">
  {{#each shows}}
    <div class="saved-show-card">
      <h4>{{this.showName}}</h4>
      {{#if this.imageURL}}
        {{!-- <br> --}}
        <img src="{{this.imageURL}}" alt="{{this.showName}}">
      {{/if}}
      <p><strong>Genre: </strong>{{this.genre}}</p>
      {{#unless @first}}<button class="moveUp" data-id="{{this.id}}">⬆️</button>{{/unless}}
      {{#unless @last}}<button class="moveDown" data-id="{{this.id}}">⬇️</button>{{/unless}}
      <button class="deleteButton" data-id="{{this.id}}">Delete</button>
    </div>
  {{/each}}
</div>
